# Production: use the managed PostgreSQL connection string from Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Server-side only. Never expose this through a VITE_* variable.
API_FOOTBALL_KEY=your_api_football_key

# Comma-separated origins are supported when previews or custom domains are needed.
FRONTEND_ORIGIN=https://your-app.vercel.app

# Optional local-development fallback when DATABASE_URL is not set.
DB_NAME=futbud
DB_USER=futbud_user
DB_PASSWORD=your_local_password
DB_HOST=localhost
DB_PORT=5432

